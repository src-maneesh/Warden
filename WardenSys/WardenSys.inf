;;;
;;; WardenSys - Windows 11 24H2/25H2 primitive file-system minifilter
;;;

[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ManufacturerName%
DriverVer   = 09/13/2026,1.0.0.0
CatalogFile = WardenSys.cat
PnpLockdown = 1

[DestinationDirs]
MiniFilter.DriverFiles = 13

;;
;; Primitive-driver installation
;;

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = MiniFilter.DriverFiles

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,MiniFilter.Service

;;
;; Service installation
;;

[MiniFilter.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDescription%
ServiceBinary  = %13%\%DriverName%.sys
Dependencies   = "FltMgr"
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "FSFilter Activity Monitor"
AddReg         = MiniFilter.AddRegistry

;;
;; Minifilter registry configuration
;; Windows 11 24H2+: minifilter instance data belongs below Parameters.
;;

[MiniFilter.AddRegistry]
HKR,"Parameters","DebugFlags",0x00010001,0x0
HKR,"Parameters","SupportedFeatures",0x00010001,0x3
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Parameters\Instances\%Instance1.Name%","Altitude",0x00000000,%Instance1.Altitude%
HKR,"Parameters\Instances\%Instance1.Name%","Flags",0x00010001,%Instance1.Flags%

;;
;; Driver files
;;

[MiniFilter.DriverFiles]
%DriverName%.sys

[SourceDisksFiles]
WardenSys.sys = 1

[SourceDisksNames]
1 = %DiskId1%

;;
;; Strings
;;

[Strings]
ManufacturerName   = "Template"
ServiceDescription = "WardenSys Mini-Filter Driver"
ServiceName        = "WardenSys"
DriverName         = "WardenSys"
DiskId1            = "WardenSys Device Installation Disk"

DefaultInstance    = "WardenSys Instance"
Instance1.Name     = "WardenSys Instance"

; MUST be replaced with the altitude assigned to your product by Microsoft.
; 389400 is only a build/install-test value and must NOT be shipped.
Instance1.Altitude = "389400"

; 0x0 = allow normal automatic attachments.
Instance1.Flags    = 0x0
